#!/usr/bin/env guile
!#
;; Compile-lint the Scheme machinery: the one check that sees a name used but
;; never defined inside a lambda body.
;;
;;   tools/compile-lint.scm                  # exits 1 on any warning
;;   tools/compile-lint.scm --no-fail        # report only
;;   tools/compile-lint.scm FILE.scm ...     # lint extra files (a config, say)
;;
;; WHY THIS EXISTS, and why the other checks cannot do it:
;;
;;   - the reader (`tools/syntax-check.scm`) never resolves names, so a typo in
;;     a rarely-run branch reads fine;
;;   - `tools/load-check.scm` only finds an unbound name if the form actually
;;     RUNS, and a `lambda` body does not run at load;
;;   - `tools/doc-exercise.scm` calls registered callbacks, which covers the
;;     wiki's thunks but nothing in the machinery itself.
;;
;; `-Wunbound-variable` at compile time sees all of them, because compilation
;; resolves every name in every branch. This is FABLE §4.6 Step F.
;;
;; HOW IT COMPILES THE MACHINERY, which is the whole difficulty:
;;
;;   1. Dependency order. A module that imports another fails with "no code for
;;      module" unless that dependency is ALREADY compiled, so the order is
;;      kernel, core, the families, extras — not the file listing.
;;   2. A GENERATED STUB KERNEL. The real kernel's export list names all ~308
;;      `hl--c-*` gsubrs, which do not exist until the compositor registers
;;      them, so the real kernel cannot be compiled outside the compositor.
;;      The stub is generated by scanning every `.scm` for `hl--c-*` symbols, so
;;      it cannot drift from the machinery: a new entry point appears in the
;;      stub the moment it is called. (The count is cross-checked against
;;      `tools/bind-audit.py`, which reads the other side of the boundary.)
;;   3. `%load-compiled-path`, not `%load-path`. Compiled dependencies are found
;;      on the former; `guild` has no `-C`, so this tool drives `compile-file`
;;      directly rather than shelling out.
;;
;; The .go files are built in a TEMPORARY directory and thrown away. They are
;; NOT a shipping artifact: the host loads every machinery file by explicit path
;; through `scm_primitive_load`, and Guile's `load` never consults a `.go` (only
;; `use-modules` does). Verified three ways — .go older than .scm, newer than
;; .scm, and with `%load-compiled-path` set — `load` read the source each time.
;; So the compile here exists for its WARNINGS, not for its output.

(use-modules (srfi srfi-1)
             (srfi srfi-13)
             (ice-9 format)
             (ice-9 ftw)
             (system base compile))

(setenv "GUILE_AUTO_COMPILE" "0")

;; ---- arguments --------------------------------------------------------------

(define argv (cdr (command-line)))
(define fail-on-warning? (not (member "--no-fail" argv)))
(define extra-files (filter (lambda (a) (not (string-prefix? "--" a))) argv))

(define repo
  (let ((self (car (command-line))))
    (dirname (dirname (if (string-prefix? "/" self) self (string-append (getcwd) "/" self))))))

(define scm-dir (string-append repo "/src/config/scheme"))

;; the load order. Kernel first (its stub), then core, then the families, then
;; the two composers (extras, emacs-keymaps) — which import the families, so
;; those must already be compiled. There is no umbrella to compile after them.
(define families
  '("core" "bind" "config" "event" "exec" "gesture" "group" "layer" "monitor"
    "notification" "query" "rule" "timer" "window" "workspace" "extras"
    "emacs-keymaps"))

(define (machinery-files)
  ;; no umbrella file: the modules ARE the machinery (see init.scm)
  (cons (string-append scm-dir "/hyprscheme/kernel.scm")
        (map (lambda (m) (string-append scm-dir "/hyprscheme/" m ".scm")) families)))

;; ---- the stub kernel --------------------------------------------------------

;; The kernel's OWN export list, read from the real file. It is the contract the
;; families import against: 308 hl--c-* gsubrs (which exist only once the
;; compositor registers them) plus ~55 real definitions (hl--error,
;; hl--plist-get, the record types, the fire trampolines …). Scanning for
;; `hl--c-*` symbols alone is NOT enough — that misses every non-gsubr export,
;; and each one then reads as unbound in the modules that call it. So the stub
;; mirrors the real list exactly, generated FROM it, and cannot drift.
(define (kernel-exports path)
  (define found #f)
  (define (walk x)
    (when (pair? x)
      (cond ((eq? (car x) '#:export) (set! found (cadr x)))
            (else (walk (car x)) (walk (cdr x))))))
  (call-with-input-file path
    (lambda (p)
      (let loop ()
        (let ((form (read p)))
          (unless (eof-object? form)
            (when (and (pair? form) (eq? (car form) 'define-module))
              (walk form))
            (loop))))))
  (or found '()))

;; The stub stands in for the real kernel: the same export list, every name a
;; no-op. It must NOT be declarative — the real kernel is `#:declarative? #f`
;; (it shadows load/eval), and the families' `use-modules` of it has to behave
;; the same way here.
(define (write-stub-kernel path names)
  (call-with-output-file path
    (lambda (p)
      (format p ";; GENERATED by tools/compile-lint.scm — do not edit.~%")
      (format p "(define-module (hyprscheme kernel) #:declarative? #f)~%")
      (for-each (lambda (n) (format p "(define (~a . _) #f)~%" n)) names)
      (format p "(export~{ ~a~})~%" names))))

;; ---- compiling --------------------------------------------------------------

(define warnings 0)
(define failures 0)

;; compile-file writes warnings to the current warning port; capture them so
;; they can be counted and printed in the tool's own voice
(define (compile-one src out)
  (catch #t
    (lambda ()
      (let* ((captured (open-output-string))
             (port (open-output-string)))
        (parameterize ((current-warning-port captured))
          (compile-file src #:output-file out #:opts '()))
        (let ((text (get-output-string captured)))
          (close-port port)
          (unless (string-null? text)
            (set! warnings (+ warnings 1))
            (for-each (lambda (line) (format #t "  ~a~%" line))
                      (string-split (string-trim-right text) #\newline)))
          #t)))
    (lambda (k . a)
      (set! failures (+ failures 1))
      (format #t "  COMPILE FAILED: ~a: ~a~%" src (if (pair? a) (car a) k))
      #f)))

;; ---- main -------------------------------------------------------------------

(define tmp (string-append "/tmp/hyprscheme-compile-lint." (number->string (getpid))))
(define (cleanup) (system (format #f "rm -rf ~a" tmp)))
(define (ensure-dir d)
  (catch #t (lambda () (mkdir d)) (lambda _ #f)))

(ensure-dir tmp)
(ensure-dir (string-append tmp "/hyprscheme"))

;; 1. the stub kernel, generated from the REAL kernel's export list
(define kexports (kernel-exports (string-append scm-dir "/hyprscheme/kernel.scm")))
(define (count-if pred l) (length (filter pred l)))
(format #t "  stub kernel: ~a exports (~a gsubrs, ~a definitions)~%"
        (length kexports)
        (count-if (lambda (s) (string-prefix? "hl--c-" (symbol->string s))) kexports)
        (count-if (lambda (s) (not (string-prefix? "hl--c-" (symbol->string s)))) kexports))
(write-stub-kernel (string-append tmp "/hyprscheme/kernel.scm") kexports)

;; 2. compile in dependency order. The stub kernel is compiled from the temp
;;    copy so that the REAL kernel is never mistaken for its own stub.
(define (rel->out rel) (string-append tmp "/" rel))

(compile-one (string-append tmp "/hyprscheme/kernel.scm")
             (string-append tmp "/hyprscheme/kernel.go"))

(let* ((core-src (string-append scm-dir "/hyprscheme/core.scm"))
       (core-dst (string-append tmp "/hyprscheme/core.go")))
  (compile-one core-src core-dst))

(for-each
 (lambda (m)
   (compile-one (string-append scm-dir "/hyprscheme/" m ".scm")
                (string-append tmp "/hyprscheme/" m ".go")))
 families)

;; 3. any extra files named on the command line — a user's config, examples, a
;;    wiki block. These compile into an environment that IMPORTS THE API, the
;;    way the host's generation does (buildGeneration step 4). Without that
;;    every `hl-*` in the file reads as unbound and the report is all false
;;    positives — which is the difference between a usable config lint and a
;;    useless one. Compiled into the same temp dir, so the imports resolve from
;;    the .go files built above.
(define (api-env)
  (let ((gen (make-fresh-user-module)))
    (module-use! gen (resolve-interface '(hyprscheme kernel)))
    (for-each (lambda (m)
                (catch #t
                  (lambda () (module-use! gen (resolve-interface (list 'hyprscheme (string->symbol m)))))
                  (lambda _ #f)))
              families)
    ;; The standard library the HOST gives the generation (Host.cpp), so this
    ;; environment matches the one a config is really evaluated in. Without it
    ;; an extra file using, say, srfi-1's `find` warns falsely — the import is
    ;; there at runtime, and a warning a config cannot act on is worse than no
    ;; warning at all.
    (for-each (lambda (m)
                (catch #t
                  (lambda () (module-use! gen (resolve-interface m)))
                  (lambda _ #f)))
              '((rnrs io ports) (rnrs lists) (srfi srfi-1)
                (ice-9 optargs) (ice-9 exceptions)))
    gen))

(for-each
 (lambda (f)
   (when (file-exists? f)
     (format #t "  (extra) ~a~%" f)
     (catch #t
       (lambda ()
         (let* ((captured (open-output-string)))
           (parameterize ((current-warning-port captured))
             (compile-file f
                           #:output-file (string-append tmp "/extra-" (basename f) ".go")
                           #:env (api-env)))
           (let ((text (get-output-string captured)))
             (unless (string-null? text)
               (set! warnings (+ warnings 1))
               (for-each (lambda (line) (format #t "  ~a~%" line))
                         (string-split (string-trim-right text) #\newline))))))
       (lambda (k . a)
         (set! failures (+ failures 1))
         (format #t "  COMPILE FAILED: ~a: ~a~%" f (if (pair? a) (car a) k))))))
 extra-files)

(cleanup)

(format #t "~a~%" (if (and (zero? warnings) (zero? failures))
                      "ok: machinery compiles clean"
                      (format #f "~a warning(s), ~a failure(s)" warnings failures)))

(exit (if (and fail-on-warning? (or (positive? warnings) (positive? failures))) 1 0))
